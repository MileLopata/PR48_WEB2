  "components": {
    "schemas": {
      "CreateQuestionRequestDTO": {
        "required": [
          "points",
          "text"
        ],
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "nullable": true
          },
          "points": {
            "type": "number",
            "format": "double"
          },
          "type": {
            "$ref": "#/components/schemas/QuestionType"
          },
          "answerOptions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionAnswerOptionDTO"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateQuizRequestDTO": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "levelOfDifficulty": {
            "$ref": "#/components/schemas/QuizLevelOfDifficulty"
          },
          "subjects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuizSubject"
            },
            "nullable": true
          },
          "timeLimit": {
            "type": "string",
            "format": "date-span"
          }
        },
        "additionalProperties": false
      },
      "CreateQuizSolvingTryRequestDTO": {
        "type": "object",
        "properties": {
          "quizId": {
            "type": "integer",
            "format": "int32"
          },
          "duration": {
            "type": "string",
            "format": "date-span"
          },
          "answers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserAnswerDTO"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "QuestionAnswerOptionDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "text": {
            "type": "string",
            "nullable": true
          },
          "isCorrect": {
            "type": "boolean",
            "nullable": true
          },
          "fillInTheBlankCorrectAnswer": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "QuestionType": {
        "enum": [
          "MULTIPLE_CHOICE_ONE_CORRECT",
          "MULTIPLE_CHOICE_MULTIPLE_CORRECT",
          "TRUE_FALSE",
          "FILL_IN_THE_BLANK"
        ],
        "type": "string"
      },
      "QuizLevelOfDifficulty": {
        "enum": [
          "BEGGINER",
          "EASY",
          "NORMAL",
          "INTERMEDIATE",
          "HARD",
          "NIGHTMARE"
        ],
        "type": "string"
      },
      "QuizSubject": {
        "enum": [
          "SPORTS",
          "NFL",
          "WORLD_OF_WARCRAFT",
          "MOVIES",
          "TV_SHOWS",
          "SCIENCE",
          "ASTRONOMY",
          "BIOLOGY",
          "HISTORY",
          "ANCIENT_WARFARE",
          "GEOGRAPHY",
          "GENERAL_KNOWLEDGE",
          "IQ_TEST"
        ],
        "type": "string"
      },
      "UpdateQuestionRequestDTO": {
        "required": [
          "points",
          "text",
          "type"
        ],
        "type": "object",
        "properties": {
          "text": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string"
          },
          "points": {
            "type": "number",
            "format": "double"
          },
          "type": {
            "$ref": "#/components/schemas/QuestionType"
          },
          "answerOptions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionAnswerOptionDTO"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdateQuizRequestDTO": {
        "required": [
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "levelOfDifficulty": {
            "$ref": "#/components/schemas/QuizLevelOfDifficulty"
          },
          "subjects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuizSubject"
            },
            "nullable": true
          },
          "timeLimit": {
            "type": "string",
            "format": "date-span"
          }
        },
        "additionalProperties": false
      },
      "UserAnswerDTO": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "integer",
            "format": "int32"
          },
          "selectedOptionIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "nullable": true
          },
          "fillInTheBlankInput": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UserLoginDTO": {
        "required": [
          "emailOrUsername",
          "password"
        ],
        "type": "object",
        "properties": {
          "emailOrUsername": {
            "maxLength": 40,
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "apiKey",
        "description": "Enter JWT token as: Bearer {your token}",
        "name": "Authorization",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}