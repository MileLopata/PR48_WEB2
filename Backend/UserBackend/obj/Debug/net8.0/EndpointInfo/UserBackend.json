{
  "openapi": "3.0.1",
  "info": {
    "title": "User Backend API",
    "version": "v1"
  },
  "paths": {
    "/api/Authentification/register": {
      "post": {
        "tags": [
          "Authentification"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "Email",
                  "Password",
                  "Username"
                ],
                "type": "object",
                "properties": {
                  "Email": {
                    "maxLength": 40,
                    "type": "string",
                    "format": "email"
                  },
                  "Username": {
                    "maxLength": 30,
                    "type": "string"
                  },
                  "Password": {
                    "type": "string"
                  },
                  "ProfilePicture": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              },
              "encoding": {
                "Email": {
                  "style": "form"
                },
                "Username": {
                  "style": "form"
                },
                "Password": {
                  "style": "form"
                },
                "ProfilePicture": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Authentification/login": {
      "post": {
        "tags": [
          "Authentification"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserLoginDTO"
